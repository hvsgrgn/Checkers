<Window x:Class="Checkers.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Checkers.View"
        mc:Ignorable="d"
        Title="Checkers Game" Height="700" Width="800"
        Background="#2C3E50">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <!-- Title Section -->
        <Border Grid.Row="0" Background="#34495E" Margin="10,10,10,5">
            <TextBlock Text="CHECKERS" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>
        
        <!-- Game Board -->
        <Border Grid.Row="1" 
                Background="#34495E" 
                Margin="10,5,10,5"
                Padding="20">
            <Viewbox Stretch="Uniform">
                <ItemsControl ItemsSource="{Binding Board}" 
                              Width="640" 
                              Height="640">
                    
                    <!-- Define the grid layout: 8x8 -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="8" Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <!-- Template for each cell -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ClickCommand}"
                                    Background="{Binding BackgroundColor}"
                                    BorderThickness="3"
                                    Padding="0">
                                
                                <!-- Border highlight style -->
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- When BorderOpacity is false, show green border -->
                                            <DataTrigger Binding="{Binding BorderOpacity}" Value="False">
                                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                
                                <!-- The checker piece image -->
                                <Image Source="{Binding FigureImage}" 
                                       Stretch="Uniform"
                                       Margin="5"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>
        </Border>
        
        <!-- Status Message Section -->
        <Border Grid.Row="2" Background="#34495E" Margin="10,5,10,10">
            <TextBlock Text="{Binding Prompt}" 
                       FontSize="18" 
                       FontWeight="SemiBold"
                       Foreground="#ECF0F1"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
